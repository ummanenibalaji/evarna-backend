# Server
PORT=3000
NODE_ENV=development

# MongoDB — must be Atlas, even for local dev.
# Long-term memory uses $vectorSearch, which only exists on Atlas (M0 free tier
# is enough). A local/self-hosted mongod will connect and appear to work, but
# memory recall silently returns nothing. Include the database name in the path.
# After setting this, run `npm run setup:db` to create the vector search index,
# then check GET /health reports "vector_index":"ready".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/evarna?retryWrites=true&w=majority

# Redis — `docker compose up -d redis` publishes it on 6380, not the default
# 6379, so it doesn't collide with other projects on the same machine.
REDIS_URL=redis://localhost:6380

# Auth — signs our own session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value signs every user out, which is the lever if it leaks.
JWT_SECRET=

# Sign-in providers. Comma-separated: a native app has a different OAuth client
# id per platform and all of them are valid audiences for the same account.
# Sign in with Apple is REQUIRED by App Store Guideline 4.8 wherever Google
# sign-in is offered — shipping Google alone is a rejection.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Optional. Without it, email sign-in codes are written to the log instead of
# being sent, which is what makes email auth work in local dev with no account.
RESEND_API_KEY=
EMAIL_FROM=Evarna <noreply@evarna.app>


# ── Conversation model (swappable) ───────────────────────────────────────────
# Empty = OpenAI. Any OpenAI-compatible endpoint works. Measured from India,
# OpenAI's first token is ~740ms and almost all of it is the round trip to a US
# origin; a local model answers in ~246ms, for a net ~350ms saving on a short
# spoken reply after its slower generation is accounted for.
#
# Embeddings and moderation deliberately stay on OpenAI: the Atlas vector index
# is 1536-dim text-embedding-3-small, and a different embedding model returns no
# memories rather than failing loudly.
#
#   ollama pull llama3
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3:latest
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ── Voice latency tuning (V-03/V-04/V-05/V-07) ───────────────────────────────
# All optional. The defaults are the shipped values; these exist so the numbers
# can be swept during a latency run without a redeploy. Measure with
# `npm run latency-report` against the voice worker's log.
#
# Silence after the caller stops before their turn is declared over. This is
# added to EVERY turn and is the largest single slice we control. LiveKit's
# own default is 500; 300 is the value it uses for streaming turn detectors.
# Raise it if the companion starts cutting people off mid-sentence.
VOICE_ENDPOINTING_MIN_MS=300
# Ceiling for a caller who trails off without a clear stop. Default was 3000.
VOICE_ENDPOINTING_MAX_MS=2500
# Words required before speech counts as an interruption. The library default
# is 0, which is why a breath or an "mm-hm" cuts the companion off mid-reply.
VOICE_INTERRUPTION_MIN_WORDS=2
# Cap on a spoken reply. The text path stays at 600. At 600 a single voice
# reply can become ~40 seconds of unstoppable speech that we pay Hume for.
VOICE_MAX_COMPLETION_TOKENS=150
# Tail guard on memory retrieval (embedding + Atlas $vectorSearch), which sits
# on the critical path before generation can start. Measured ~330ms warm.
# Lowering this buys latency by answering without memories more often — a real
# quality trade. 0 disables the bound.
VOICE_MEMORY_DEADLINE_MS=600
# Characters of the opening reply to accumulate before the first flush to Hume.
# Lower starts audio sooner but gives Hume a shorter phrase to work with; the
# cut is always at a word boundary. Measured: Hume returns first audio ~380ms
# after a flush, so this is the part of the TTS stage we control.
VOICE_FIRST_FLUSH_CHARS=20

# Speculative TTS: synthesise before the turn is confirmed, so Hume's ~300-450ms
# is spent while the caller is still finishing. OFF by default because the audio
# is discarded whenever they keep talking, and TTS is ~85% of per-minute cost.
# VOICE_PREEMPTIVE_TTS=true

# OpenAI
OPENAI_API_KEY=sk-...

# LiveKit (Sprint 4)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Deepgram (Sprint 4)
DEEPGRAM_API_KEY=

# Hume AI (Sprint 4)
HUME_API_KEY=
HUME_SECRET_KEY=
